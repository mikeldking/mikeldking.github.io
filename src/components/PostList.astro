---
import { formatDate, postUrl, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a href={postUrl(post)}>
        <span class="title">{post.data.title}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </a>
    </li>
  ))}
</ul>
